{
  "manifest_version": 3,
  "name": "עוגן פליי - התראות צוות",
  "description": "התראות לצוות פיקוח וניהול של עוגן פליי - סורק כל דקה ומודיע על אפליקציות/דיווחים/הודעות חדשות שממתינים לטיפול.",
  "version": "1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "notifications", "alarms", "tabs"],
  "host_permissions": ["https://*/*", "http://localhost/*"],
  "options_page": "options.html"
}
