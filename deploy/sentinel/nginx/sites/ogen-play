server {
    server_name ogenplay.com www.ogenplay.com 84.13.81.124;
    client_max_body_size 20m;
    limit_conn ogen_addr_v2 40;
    include snippets/ogen-waf.conf;
    location /_next/static/ {
        alias /opt/ogen-play/.next/static/;
        expires 1y;
        access_log off;
        log_not_found off;
        error_page 404 = @ogen_node;
    }

    location @ogen_node {
        proxy_pass http://ogen_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ogen_conn_upgrade;
        proxy_set_header Accept-Encoding "";
    }

    location /_next/image {
        limit_req zone=ogen_media_v2 burst=250 nodelay;
        proxy_pass http://ogen_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection $ogen_conn_upgrade;
        proxy_set_header Accept-Encoding "";
        proxy_cache ogen;
        proxy_cache_valid 200 30d;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503;
    }

    location /api/cdn/ {
        limit_req zone=ogen_media_v2 burst=250 nodelay;
        proxy_pass http://ogen_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection $ogen_conn_upgrade;
        proxy_set_header Accept-Encoding "";
        proxy_cache ogen;
        proxy_cache_valid 200 7d;
        proxy_cache_lock on;
        proxy_cache_bypass $http_range;
        proxy_no_cache $http_range;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503;
    }

    location = /api/bot/chat {
        limit_req zone=ogen_botchat_v2 burst=5 nodelay;
        proxy_pass http://ogen_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection $ogen_conn_upgrade;
        proxy_set_header Accept-Encoding "";
    }

    location ~ ^/(|users|forum|about|site-reviews|community|site-rules|terms|privacy|advertise)$ {
        limit_req zone=ogen_general_v2 burst=40 nodelay;
        proxy_pass http://ogen_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection $ogen_conn_upgrade;
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        proxy_busy_buffers_size 64k;
        proxy_cache ogen_html;
        proxy_cache_key "$scheme$host$request_uri|$cookie_ogen_lang";
        proxy_cache_valid 200 15s;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 8s;
        proxy_cache_bypass $ogen_nocache;
        proxy_no_cache $ogen_nocache;
        proxy_ignore_headers Cache-Control Expires;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
    }

    location = /api/apps/rest {
        limit_req zone=ogen_general_v2 burst=40 nodelay;
        proxy_pass http://ogen_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection $ogen_conn_upgrade;
        proxy_cache ogen_html;
        proxy_cache_key "$scheme$host$request_uri";
        proxy_cache_valid 200 15s;
        proxy_cache_lock on;
        proxy_ignore_headers Cache-Control Expires;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
    }

    location / {
        limit_req zone=ogen_general_v2 burst=40 nodelay;
        limit_req zone=ogen_authsb_v2 burst=8 nodelay;
        proxy_pass http://ogen_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ogen_conn_upgrade;
        proxy_set_header Accept-Encoding "";
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        proxy_busy_buffers_size 64k;
        proxy_next_upstream error timeout http_502 http_503;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl http2; # managed by Certbot
    large_client_header_buffers 4 32k;
    ssl_certificate /etc/letsencrypt/live/ogenplay.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/ogenplay.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = www.ogenplay.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = ogenplay.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name ogenplay.com www.ogenplay.com 84.13.81.124;
    return 404; # managed by Certbot




}
